{
  "name": "ball-manager-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST du SaaS multi-clubs (FFBB/FBI/e-Marque) — Vercel + Supabase uniquement, voir ARCHITECTURE.md.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vercel-build": "echo 'Rien à builder côté Vercel : fonctions Node compilées à la volée par le runtime.'",
    "fbi:probe": "tsx ops/fbi-session-worker/probe.ts",
    "fbi:worker": "tsx ops/fbi-session-worker/worker.ts",
    "fbi:worker:ctl": "tsx ops/fbi-session-worker/ctl.ts",
    "fbi:login-test": "tsx ops/fbi-login-test/login-once.ts",
    "fbi:local-worker": "tsx ops/fbi-local-worker/run.ts",
    "emarque:debug-licenses": "tsx ops/emarque-debug/license-cells.ts",
    "docs:routes": "tsx ops/docs/generate-routes-doc.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@napi-rs/canvas": "^1.0.9",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.8",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
