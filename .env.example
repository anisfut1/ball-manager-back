# Copier vers .env pour le développement local (`npm run dev`). Ne JAMAIS
# commiter le fichier .env réel. En production, ces variables se configurent
# dans le tableau de bord Vercel (Project Settings > Environment Variables),
# jamais dans un fichier commité.
#
# MÊME instance Supabase que le frontend ball-manager-web — voir docs/DEPLOYMENT.md.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM, 32 octets encodés en base64 (ex: `openssl rand -base64 32`).
# DOIT être EXACTEMENT la même valeur déjà utilisée côté ball-manager-web tant que les
# deux repos coexistent (voir "Duplication temporaire" dans le README) —
# sinon les identifiants FBI déjà chiffrés en base deviennent illisibles.
FBI_CREDENTIALS_ENCRYPTION_KEY=

# Protège /internal/* (cron Vercel + jobs) — au moins 16 caractères aléatoires.
CRON_SECRET=

# Liste d'origines autorisées en CORS, séparées par des virgules (jamais de
# wildcard avec authentification, voir docs/API.md). Ex :
# FRONTEND_ORIGINS=https://scsb.vercel.app,http://localhost:3000
FRONTEND_ORIGINS=

# Active la stratégie de secours BrowserFbiClient (Playwright + Chromium
# serverless) — désactivée par défaut : non officiellement supportée par
# Vercel, voir docs/FBI.md pour les limites réelles constatées. HttpFbiClient
# reste la stratégie principale quelle que soit cette valeur.
BROWSER_FBI_ENABLED=false

# Optionnel, valeur par défaut raisonnable si absent (voir src/config/env.ts).
# FBI_BASE_URL=https://extranet.ffbb.com/fbi

# Optionnel : proxy à adresse IP FIXE pour le trafic navigateur vers FBI
# (jamais un proxy rotatif). Format : http://utilisateur:motdepasse@hote:port
# FBI_PROXY_URL=

# Envoi des liens personnels sans compte par email, via Resend (voir
# docs/PUBLIC_TABLE_ACCESS.md). Sans clé, la demande de lien répond 503.
# Sans domaine vérifié sur Resend, garder l'expéditeur onboarding@resend.dev :
# Resend ne livre alors QU'À l'adresse du propriétaire du compte Resend.
# RESEND_API_KEY=
# RESEND_FROM=SC Sète Basket <onboarding@resend.dev>
# Adresse de réponse (boîte réellement lue), conseillée pour la délivrabilité :
# RESEND_REPLY_TO=contact@domaine-du-club.fr
# PUBLIC_APP_URL=https://scsb.vercel.app
# App iOS / liens (docs/MOBILE_AUTH.md) : « 1 » = emails de lien personnel avec
# code de connexion à usage unique (48 h) au lieu du jeton permanent.
# AUTH_LINK_CODES=1

# Notifications push de l'app iOS (APNs direct). Clé .p8 créée dans Apple
# Developer → Keys (« Apple Push Notifications service »). Toutes absentes =
# push désactivé (aucune notification mise en file). Jamais commitées.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=fr.ballmanager.app
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
